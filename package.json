{
  "name": "api-catalogo-productos",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos con favoritos, autenticación JWT y roles",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:init": "node --env-file=.env scripts/init-db.js",
    "crear-admin": "node --env-file=.env scripts/crear-admin.js",
    "token:expirado": "node --env-file=.env scripts/token-expirado.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
